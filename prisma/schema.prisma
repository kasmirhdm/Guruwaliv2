generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GURUWALI_ADMIN
  SCHOOL_ADMIN
  TEACHER
}

enum TeacherMode {
  INDIVIDUAL
  SCHOOL
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum CurriculumSource {
  PLATFORM_MASTER
  SCHOOL
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  role         UserRole        @default(TEACHER)
  teacherMode  TeacherMode? 
  status       String          @default("ACTIVE")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  memberships  SchoolMembership[]
  sessions     Session[]
  ownedDocuments Document[]    @relation("DocumentOwner")
  teachingDevices TeachingDevice[]
  homeroomClasses SchoolClass[] @relation("HomeroomTeacher")
}

model School {
  id              String             @id @default(cuid())
  name            String
  npsn            String?            @unique
  address         String?
  logoPath        String?
  principalName   String?
  principalNip    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  memberships     SchoolMembership[]
  academicYears   AcademicYear[]
  classes         SchoolClass[]
  subjects        Subject[]
  curricula       Curriculum[]
  documents       Document[]
  teachingDevices TeachingDevice[]
}

model SchoolMembership {
  id        String           @id @default(cuid())
  schoolId  String
  userId    String
  role      UserRole
  status    MembershipStatus @default(PENDING)
  joinedAt  DateTime?
  createdAt DateTime         @default(now())
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([schoolId, userId])
  @@index([userId, status])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  semester  String
  isActive  Boolean  @default(false)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@index([schoolId, isActive])
}

model SchoolClass {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  grade     String?
  homeroomTeacherId String?
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@index([schoolId])
}

model MasterSubject {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String?
  isActive    Boolean   @default(true)
  subjects    Subject[]
  outcomes    LearningOutcome[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([isActive])
}

model Subject {
  id              String         @id @default(cuid())
  schoolId        String
  masterSubjectId String?
  name            String
  code            String?
  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  masterSubject   MasterSubject? @relation(fields: [masterSubjectId], references: [id], onDelete: SetNull)
  @@index([schoolId])
  @@index([masterSubjectId])
}

model MasterCurriculumRevision {
  id           String   @id @default(cuid())
  curriculumId String?
  version      Int
  label        String?
  snapshot     Json
  createdById  String?
  createdAt    DateTime @default(now())
  curriculum   Curriculum? @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  @@unique([curriculumId, version])
  @@index([curriculumId, createdAt])
}

model Curriculum {
  id          String              @id @default(cuid())
  schoolId    String?
  name        String
  description String?
  sourceType  CurriculumSource     @default(PLATFORM_MASTER)
  school      School?             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  phases      Phase[]
  outcomes    LearningOutcome[]
  revisions   MasterCurriculumRevision[]
  @@index([schoolId, sourceType])
}

model Phase {
  id           String       @id @default(cuid())
  curriculumId String
  name         String
  curriculum   Curriculum   @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  outcomes     LearningOutcome[]
  @@index([curriculumId])
}

model LearningOutcome {
  id           String            @id @default(cuid())
  curriculumId String
  phaseId      String
  subjectId    String?
  masterSubjectId String?
  title        String
  content      String
  sourceType   CurriculumSource  @default(PLATFORM_MASTER)
  isMaster     Boolean           @default(false)
  isActive     Boolean           @default(true)
  curriculum   Curriculum       @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  phase        Phase             @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  masterSubject MasterSubject?    @relation(fields: [masterSubjectId], references: [id], onDelete: SetNull)
  objectives   LearningObjective[]
  @@index([curriculumId, phaseId, subjectId])
  @@index([masterSubjectId, isMaster])
}

model LearningObjective {
  id         String           @id @default(cuid())
  outcomeId  String
  title      String
  content    String
  outcome    LearningOutcome   @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  sequences  LearningSequence[]
  materials  LearningMaterial[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LearningSequence {
  id          String            @id @default(cuid())
  objectiveId String
  title       String
  content     String
  objective   LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LearningMaterial {
  id          String            @id @default(cuid())
  sequenceId  String
  title       String
  content     String
  sequence    LearningSequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([sequenceId])
}

enum TeachingDeviceType {
  MODUL_AJAR
  LKPD
  BAHAN_AJAR
  ASESMEN
  KISI_KISI
  PROGRAM_SEMESTER
  PROGRAM_TAHUNAN
}

model TeachingDevice {
  id                String             @id @default(cuid())
  ownerUserId       String
  schoolId          String?
  type              TeachingDeviceType
  title             String
  subjectName       String?
  className         String?
  academicYear      String?
  curriculumId      String?
  phaseId           String?
  outcomeId         String?
  objectiveId       String?
  sequenceId        String?
  materialId        String?
  content           Json?
  status            String             @default("DRAFT")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  owner             User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  school            School?            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@index([ownerUserId, type])
  @@index([schoolId, type])
  @@index([outcomeId, objectiveId, sequenceId])
}

model Document {
  id          String   @id @default(cuid())
  ownerUserId String
  schoolId    String?
  type        String
  title       String
  filePath    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation("DocumentOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@index([ownerUserId])
  @@index([schoolId])
}
