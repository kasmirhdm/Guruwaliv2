generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GURUWALI_ADMIN
  SCHOOL_ADMIN
  TEACHER
}

enum TeacherMode {
  INDIVIDUAL
  SCHOOL
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum CurriculumSource {
  PLATFORM_MASTER
  SCHOOL
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  role         UserRole        @default(TEACHER)
  teacherMode  TeacherMode? 
  status       String          @default("ACTIVE")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  memberships  SchoolMembership[]
  sessions     Session[]
  ownedDocuments Document[]    @relation("DocumentOwner")
  teachingDevices TeachingDevice[]
  homeroomClasses SchoolClass[] @relation("HomeroomTeacher")
  gradeEntries GradeEntry[] @relation("TeacherGrades")
  questions Question[]
}

model School {
  id              String             @id @default(cuid())
  name            String
  npsn            String?            @unique
  address         String?
  logoPath        String?
  principalName   String?
  principalNip    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  memberships     SchoolMembership[]
  academicYears   AcademicYear[]
  classes         SchoolClass[]
  subjects        Subject[]
  curricula       Curriculum[]
  documents       Document[]
  teachingDevices TeachingDevice[]
  students        Student[]
  importedTeachers ImportedTeacher[]
  dapodikImports DapodikImportLog[]
  reportPeriods ReportPeriod[]
  questions Question[]
}

model SchoolMembership {
  id        String           @id @default(cuid())
  schoolId  String
  userId    String
  role      UserRole
  status    MembershipStatus @default(PENDING)
  joinedAt  DateTime?
  createdAt DateTime         @default(now())
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([schoolId, userId])
  @@index([userId, status])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  semester  String
  isActive  Boolean  @default(false)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@index([schoolId, isActive])
}

model SchoolClass {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  grade     String?
  homeroomTeacherId String?
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  homeroomTeacher User? @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  teachingDevices TeachingDevice[]
  students        Student[]
  @@index([schoolId])
  @@index([homeroomTeacherId])
}

model MasterSubject {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String?
  isActive    Boolean   @default(true)
  subjects    Subject[]
  outcomes    LearningOutcome[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([isActive])
}

model Subject {
  id              String         @id @default(cuid())
  schoolId        String
  masterSubjectId String?
  name            String
  code            String?
  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  masterSubject   MasterSubject? @relation(fields: [masterSubjectId], references: [id], onDelete: SetNull)
  outcomes        LearningOutcome[]
  @@index([schoolId])
  @@index([masterSubjectId])
}

model MasterCurriculumRevision {
  id           String   @id @default(cuid())
  curriculumId String?
  version      Int
  label        String?
  snapshot     Json
  createdById  String?
  createdAt    DateTime @default(now())
  curriculum   Curriculum? @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  @@unique([curriculumId, version])
  @@index([curriculumId, createdAt])
}

model Curriculum {
  id          String              @id @default(cuid())
  schoolId    String?
  name        String
  description String?
  sourceType  CurriculumSource     @default(PLATFORM_MASTER)
  school      School?             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  phases      Phase[]
  outcomes    LearningOutcome[]
  revisions   MasterCurriculumRevision[]
  @@index([schoolId, sourceType])
}

model Phase {
  id           String       @id @default(cuid())
  curriculumId String
  name         String
  curriculum   Curriculum   @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  outcomes     LearningOutcome[]
  @@index([curriculumId])
}

model LearningOutcome {
  id           String            @id @default(cuid())
  curriculumId String
  phaseId      String
  subjectId    String?
  masterSubjectId String?
  title        String
  content      String
  sourceType   CurriculumSource  @default(PLATFORM_MASTER)
  isMaster     Boolean           @default(false)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  curriculum   Curriculum       @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  phase        Phase             @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  masterSubject MasterSubject?    @relation(fields: [masterSubjectId], references: [id], onDelete: SetNull)
  subject      Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  objectives   LearningObjective[]
  @@index([curriculumId, phaseId, subjectId])
  @@index([masterSubjectId, isMaster])
}

model LearningObjective {
  id         String           @id @default(cuid())
  outcomeId  String
  title      String
  content    String
  outcome    LearningOutcome   @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  sequences  LearningSequence[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([outcomeId])
}

model LearningSequence {
  id          String            @id @default(cuid())
  objectiveId String
  title       String
  content     String
  objective   LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  materials   LearningMaterial[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([objectiveId])
}

model LearningMaterial {
  id          String            @id @default(cuid())
  sequenceId  String
  title       String
  content     String
  sequence    LearningSequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([sequenceId])
}

enum TeachingDeviceType {
  MODUL_AJAR
  LKPD
  BAHAN_AJAR
  ASESMEN
  KISI_KISI
  PROGRAM_SEMESTER
  PROGRAM_TAHUNAN
}

model TeachingDevice {
  id                String             @id @default(cuid())
  ownerUserId       String
  schoolId          String?
  type              TeachingDeviceType
  title             String
  subjectName       String?
  className         String?
  academicYear      String?
  curriculumId      String?
  phaseId           String?
  outcomeId         String?
  objectiveId       String?
  sequenceId        String?
  materialId        String?
  schoolClassId     String?
  content           Json?
  status            String             @default("DRAFT")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  owner             User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  school            School?            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolClass       SchoolClass?       @relation(fields: [schoolClassId], references: [id], onDelete: SetNull)
  @@index([ownerUserId, type])
  @@index([schoolId, type])
  @@index([outcomeId, objectiveId, sequenceId])
}

model Document {
  id          String   @id @default(cuid())
  ownerUserId String
  schoolId    String?
  type        String
  title       String
  filePath    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation("DocumentOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@index([ownerUserId])
  @@index([schoolId])
}

model Student {
  id          String      @id @default(cuid())
  schoolId    String
  schoolClassId String?
  nis         String?
  nisn        String?
  nik         String?
  name        String
  gender      String?
  birthPlace  String?
  birthDate   DateTime?
  address     String?
  parentName  String?
  parentPhone String?
  status      String      @default("ACTIVE")
  source      String      @default("MANUAL")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass? @relation(fields: [schoolClassId], references: [id], onDelete: SetNull)
  grades GradeEntry[]
  reportNotes ReportNote[]
  @@index([schoolId, schoolClassId])
  @@index([schoolId, name])
  @@index([schoolId, nik])
}

model ImportedTeacher {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  nip         String?
  nuptk       String?
  nik         String?
  email       String?
  phone       String?
  status      String   @default("IMPORTED")
  source      String   @default("DAPODIK")
  linkedUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@index([schoolId, name])
}


model ReportPeriod {
  id           String   @id @default(cuid())
  schoolId     String
  academicYear String
  semester     String
  name         String
  isActive     Boolean  @default(true)
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grades       GradeEntry[]
  notes        ReportNote[]
  @@index([schoolId, academicYear, semester])
}

model GradeEntry {
  id          String      @id @default(cuid())
  periodId    String
  studentId   String
  subjectId   String?
  subjectName String
  teacherId   String?
  knowledge   Float?
  skill       Float?
  finalScore  Float?
  predicate   String?
  description String?
  period      ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher     User?       @relation("TeacherGrades", fields: [teacherId], references: [id], onDelete: SetNull)
  @@unique([periodId, studentId, subjectName])
  @@index([studentId, periodId])
}

model ReportNote {
  id        String       @id @default(cuid())
  periodId  String
  studentId String
  category  String
  note      String
  period    ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([periodId, studentId, category])
  @@index([studentId, periodId])
}

model Question {
  id          String   @id @default(cuid())
  ownerUserId String
  schoolId    String?
  subjectName String
  outcomeId   String?
  objectiveId String?
  sequenceId  String?
  materialId  String?
  type        String   @default("PILIHAN_GANDA")
  question    String
  options     Json?
  answer      String
  explanation String?
  difficulty  String   @default("SEDANG")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@index([ownerUserId])
  @@index([schoolId, subjectName])
}

model DapodikImportLog {
  id             String   @id @default(cuid())
  schoolId       String
  fileName       String
  studentsCreated Int     @default(0)
  studentsUpdated Int     @default(0)
  teachersImported Int    @default(0)
  classesCreated Int      @default(0)
  matchedClasses Int      @default(0)
  createdAt      DateTime @default(now())
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@index([schoolId, createdAt])
}
